# SentinelAI - Example environment configuration
# Copy this file to .env and configure local values as needed.

APP_NAME=SentinelAI
APP_ENV=development

APP_HOST=127.0.0.1
APP_PORT=8000

LOG_LEVEL=INFO

# Qdrant
QDRANT_MODE=local
QDRANT_LOCAL_PATH=.qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sentinel_ai_documents

# RAG models
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANK_MODEL=answerdotai/answerai-colbert-small-v1

# Retrieval
DENSE_PREFETCH_LIMIT=12
SPARSE_PREFETCH_LIMIT=12
RETRIEVAL_CANDIDATE_LIMIT=15
RETRIEVAL_TOP_K=5
INGESTION_BATCH_SIZE=8

RETRIEVAL_STRATEGY=rrf

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna